// Teil E: drei Varianten desselben Programms
digraph variants {
    rankdir=TB;
    graph [fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.4,
           label=<<b>Teil E: Was steckt im Programm, was kommt zur Laufzeit dazu?</b>>,
           labelloc=t, fontsize=18];
    node [fontname="Helvetica", fontsize=12, shape=plaintext];

    t [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
        <tr><td bgcolor="#424242"><font color="white"><b>Programm</b></font></td>
            <td bgcolor="#424242"><font color="white"><b>libversion</b></font></td>
            <td bgcolor="#424242"><font color="white"><b>{fmt}</b></font></td>
            <td bgcolor="#424242"><font color="white"><b>libstdc++</b></font></td>
            <td bgcolor="#424242"><font color="white"><b>libc</b></font></td>
            <td bgcolor="#424242"><font color="white"><b>Größe</b><br/>Debug / strip</font></td></tr>
        <tr><td align="left"><b>exercise-004</b></td>
            <td bgcolor="#bbdefb">im Programm</td><td bgcolor="#e1bee7">libfmt.so.12</td><td bgcolor="#e1bee7">.so</td><td bgcolor="#e1bee7">.so</td><td>103 KB / 19 KB</td></tr>
        <tr><td align="left"><b>exercise-004-static</b></td>
            <td bgcolor="#bbdefb">im Programm</td><td bgcolor="#bbdefb">im Programm<br/>(header-only)</td><td bgcolor="#e1bee7">.so</td><td bgcolor="#e1bee7">.so</td><td>860 KB / 195 KB</td></tr>
        <tr><td align="left"><b>exercise-004-full-static</b></td>
            <td bgcolor="#bbdefb">im Programm</td><td bgcolor="#bbdefb">im Programm</td><td bgcolor="#bbdefb">im Programm</td><td bgcolor="#bbdefb">im Programm</td><td>2,8 MB / 1,8 MB</td></tr>
        <tr><td colspan="6" align="left"><font point-size="12"><font color="#1565c0">■</font> statisch: zur Linkzeit kopiert     <font color="#6a1b9a">■</font> dynamisch: zur Laufzeit von ld.so geladen</font></td></tr>
      </table>>];

    upd [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
        <tr><td colspan="2" bgcolor="#c62828"><font color="white"><b>Frage E2: Sicherheitslücke in {fmt} oder libc</b></font></td></tr>
        <tr><td bgcolor="#f3e5f5" align="left"><b>dynamisch</b></td><td align="left">Paket aktualisieren (apt upgrade), Programme neu starten.<br align="left"/>Kein Neubauen nötig, alle Programme profitieren sofort.<br align="left"/></td></tr>
        <tr><td bgcolor="#e3f2fd" align="left"><b>statisch</b></td><td align="left">Jedes betroffene Programm neu bauen und neu ausliefern.<br align="left"/>Wer das vergisst, behält die Lücke – auch wenn das System aktuell ist.<br align="left"/></td></tr>
      </table>>];
    t -> upd [style=invis];
}
