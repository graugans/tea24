// AUTOMATISCH ERZEUGT von CMake, nur Hintergrundfarbe ergänzt:
//   cmake --graphviz=exercise-003/doc/04_cmake_targets.dot build
digraph "tea24" {
graph [bgcolor="white", fontname="Helvetica", label="cmake --graphviz: alle Targets des Projekts tea24 (gepunktet = PRIVATE, gestrichelt = INTERFACE)", labelloc=t, fontsize=14];
node [
  fontsize = "12"
];
subgraph clusterLegend {
  label = "Legend";
  color = black;
  edge [ style = invis ];
  legendNode0 [ label = "Executable", shape = egg ];
  legendNode1 [ label = "Static Library", shape = octagon ];
  legendNode2 [ label = "Shared Library", shape = doubleoctagon ];
  legendNode3 [ label = "Module Library", shape = tripleoctagon ];
  legendNode4 [ label = "Interface Library", shape = pentagon ];
  legendNode5 [ label = "Object Library", shape = hexagon ];
  legendNode6 [ label = "Unknown Library", shape = septagon ];
  legendNode7 [ label = "Custom Target", shape = box ];
  legendNode0 -> legendNode1 [ style = solid ];
  legendNode0 -> legendNode2 [ style = solid ];
  legendNode0 -> legendNode3;
  legendNode1 -> legendNode4 [ label = "Interface", style = dashed ];
  legendNode2 -> legendNode5 [ label = "Private", style = dotted ];
  legendNode3 -> legendNode6 [ style = solid ];
  legendNode0 -> legendNode7;
}
    "node0" [ label = "exercise-000", shape = egg ];
    "node1" [ label = "CLI11::CLI11", shape = pentagon ];
    "node0" -> "node1" [ style = dotted ] // exercise-000 -> CLI11::CLI11
    "node2" [ label = "fmt::fmt", shape = doubleoctagon ];
    "node0" -> "node2" [ style = dotted ] // exercise-000 -> fmt::fmt
    "node3" [ label = "exercise-001", shape = egg ];
    "node3" -> "node1" [ style = dotted ] // exercise-001 -> CLI11::CLI11
    "node3" -> "node2" [ style = dotted ] // exercise-001 -> fmt::fmt
    "node4" [ label = "exercise-002", shape = egg ];
    "node4" -> "node2" [ style = dotted ] // exercise-002 -> fmt::fmt
    "node5" [ label = "exercise-003", shape = egg ];
    "node5" -> "node2" [ style = dotted ] // exercise-003 -> fmt::fmt
    "node6" [ label = "version_library\n(tea24::version)", shape = octagon ];
    "node6" -> "node2" [ style = dotted ] // version_library -> fmt::fmt
    "node5" -> "node6" [ style = dotted ] // exercise-003 -> version_library
    "node7" [ label = "exercise-003-c", shape = egg ];
    "node7" -> "node6" [ style = dotted ] // exercise-003-c -> version_library
    "node8" [ label = "exercise-003-cli", shape = egg ];
    "node8" -> "node1" [ style = dotted ] // exercise-003-cli -> CLI11::CLI11
    "node8" -> "node2" [ style = dotted ] // exercise-003-cli -> fmt::fmt
    "node9" [ label = "nlohmann_json::nlohmann_json", shape = pentagon ];
    "node8" -> "node9" [ style = dotted ] // exercise-003-cli -> nlohmann_json::nlohmann_json
    "node8" -> "node6" [ style = dotted ] // exercise-003-cli -> version_library
    "node10" [ label = "exercise-003-shared", shape = egg ];
    "node10" -> "node2" [ style = dotted ] // exercise-003-shared -> fmt::fmt
    "node11" [ label = "version_library_shared\n(tea24::version_shared)", shape = doubleoctagon ];
    "node11" -> "node2" [ style = dotted ] // version_library_shared -> fmt::fmt
    "node10" -> "node11" [ style = dotted ] // exercise-003-shared -> version_library_shared
    "node12" [ label = "version_library_test", shape = egg ];
    "node13" [ label = "Catch2::Catch2WithMain", shape = octagon ];
    "node14" [ label = "Catch2::Catch2", shape = octagon ];
    "node13" -> "node14" [ style = dashed ] // Catch2::Catch2WithMain -> Catch2::Catch2
    "node12" -> "node13" [ style = dotted ] // version_library_test -> Catch2::Catch2WithMain
    "node12" -> "node6" [ style = dotted ] // version_library_test -> version_library
}
