// Vom Quelltext zur Binärdatei – zwei Übersetzungseinheiten, ein Linker
digraph build {
    rankdir=LR;
    graph [fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.55,
           label="Vom Quelltext zur Binärdatei: jede .cpp-Datei wird einzeln übersetzt, erst der Linker fügt alles zusammen",
           labelloc=t, fontsize=14];
    node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#fff9c4", color="#827717"];
    edge  [fontname="Helvetica", fontsize=9, color="#616161"];

    subgraph cluster_headers {
        label="Header – nur Deklarationen"; fontsize=10; style="rounded,dashed"; color="#9e9e9e";
        module_h [label="module.h"];
        helper_h [label="helper.h"];
        bonus_h  [label="bonus_config.h"];
        config_h [label="config.h\n(von CMake aus config.h.in)"];
    }

    main_cpp   [label="main.cpp",   fillcolor="#ffe082"];
    module_cpp [label="module.cpp", fillcolor="#ffe082"];

    subgraph cluster_tu1 {
        label="Übersetzungseinheit 1"; fontsize=10; style="rounded,filled"; fillcolor="#f5f5f5"; color="#bdbdbd";
        pp1 [label="Präprozessor\n#include = Text einfügen", fillcolor="white", color="#616161"];
        cc1 [label="Compiler\nclang++ -c", fillcolor="white", color="#616161"];
        pp1 -> cc1 [label="TU"];
    }
    subgraph cluster_tu2 {
        label="Übersetzungseinheit 2"; fontsize=10; style="rounded,filled"; fillcolor="#f5f5f5"; color="#bdbdbd";
        pp2 [label="Präprozessor\n#include = Text einfügen", fillcolor="white", color="#616161"];
        cc2 [label="Compiler\nclang++ -c", fillcolor="white", color="#616161"];
        pp2 -> cc2 [label="TU"];
    }

    main_o [shape=note, style=filled, fillcolor="#e3f2fd", color="#1565c0",
            label="main.cpp.o\l─────────────\lT main\lD shadow\lU foo, U data, U rodata …\lU doSomethingStatic()\l"];
    module_o [shape=note, style=filled, fillcolor="#e3f2fd", color="#1565c0",
            label="module.cpp.o\l─────────────\lB foo, B bss …\lD data, D data2\lR rodata, R big_data_blob\ld shadow  b moduleCounter\lT doSomethingStatic() …\l"];

    ld  [label="Linker (ld)\nverbindet jedes U\nmit genau einer Definition", shape=box, style="filled", fillcolor="#ffccbc", color="#bf360c"];
    fmt [label="libfmt.so", shape=cylinder, style=filled, fillcolor="#eeeeee", color="#757575"];
    exe [label="build/bin/exercise-002\n(ELF, PIE)", shape=box3d, style=filled, fillcolor="#c8e6c9", color="#2e7d32"];
    size [label="POST_BUILD\nsize --format=sysv", shape=plaintext, fontcolor="#2e7d32"];

    main_cpp   -> pp1;
    module_cpp -> pp2;
    module_h -> pp1 [style=dashed]; config_h -> pp1 [style=dashed];
    module_h -> pp2 [style=dashed]; bonus_h  -> pp2 [style=dashed, label="2×"];
    helper_h -> module_h [style=dotted, arrowhead=none, label="inkludiert"];
    cc1 -> main_o;
    cc2 -> module_o;
    main_o -> ld; module_o -> ld; fmt -> ld [style=dashed];
    ld -> exe;
    exe -> size [style=dotted, arrowhead=none];
}
